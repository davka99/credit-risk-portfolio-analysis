DEFINE
    MEASURE MonthlySnapshots[ECL Proxy] =
        SUMX(
            MonthlySnapshots,
            MonthlySnapshots[ead]
                * IF(MonthlySnapshots[dpd] >= 90, 1, RELATED(Loans[pd_12m_assumed]))
                * RELATED(Loans[lgd_assumed])
        )

EVALUATE
CALCULATETABLE(
    ROW(
        "Period", "December 2025",
        "ECL Proxy", [ECL Proxy]
    ),
    MonthlySnapshots[month] = DATE(2025, 12, 1)
)